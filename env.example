# Nothing here is required: set URLs, tokens, the model, mode and schedules on the Settings page (or PATCH /api/v1/settings).
# An environment variable wins over the page and greys the field out, so set one only to lock it. Secrets here: Unraid's masked
# template variables, or files with NAME_FILE=/run/secrets/name.

# Environment only
TZ=UTC                                  # schedules and job dates use this zone
# MANDOS_DISABLE_AUTH=1                 # no login screen (put mandos behind your own gate); also turns the code editor off
# MANDOS_ALLOW_EDIT=0                   # turn the Jobs page editor off
# MANDOS_INSECURE_COOKIE=1              # plain http on a host other than localhost
# MANDOS_STARTER=1                      # copy the starter pack into /data/jobs on first start
# MANDOS_DB=/data/mandos.db  MANDOS_JOBS=/data/jobs

# Also settable on the Settings page
# MANDOS_MODE=shadow                    # shadow (trial: alerts marked, no heartbeat) or live
# MANDOS_BASE_URL=https://mandos.example
# LLM_URL=http://llama-swap:8080        # OpenAI-compatible (/v1); llama-swap, Ollama's /v1
# LLM_MODEL=  EMBED_MODEL=  LLM_KEY=
# PUSHOVER_TOKEN=  PUSHOVER_USER=  KUMA_PUSH_URL=
# PROM_URL=  PIHOLE_URL=  LOGLOOK_URL=  LOGLOOK_TOKEN=
# ULMO_URL=  ULMO_TOKEN=  ULMO_CHANGE_TOKEN=  ULMO_ROLE=mandos
# HA_URL=  HA_TOKEN=
# CRON_<JOB>=                           # one per job in the pack, e.g. CRON_TARGETS; empty turns it off
